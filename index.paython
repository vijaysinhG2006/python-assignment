def get_matrix(name):
    rows = int(input(f"Enter number of rows for {name}: "))
    cols = int(input(f"Enter number of columns for {name}: "))
    print(f"Enter elements of {name} row by row:")
    elements = []
    for i in range(rows):
        row = list(map(int, input(f"Row {i+1}: ").split()))
        elements.append(row)
    return np.array(elements)

print("Matrix Calculator using NumPy")
print("Choose an operation:")
print("1. Addition")
print("2. Subtraction")
print("3. Multiplication")
print("4. Transpose")

choice = int(input("Enter your choice (1-4): "))

if choice in [1, 2, 3]:
    A = get_matrix("Matrix A")
    B = get_matrix("Matrix B")

    if choice == 1:
        if A.shape == B.shape:
            print("Result:\n", np.add(A, B))
        else:
            print("Error: Matrices must be the same shape for addition.")
    elif choice == 2:
        if A.shape == B.shape:
            print("Result:\n", np.subtract(A, B))
        else:
            print("Error: Matrices must be the same shape for subtraction.")
    elif choice == 3:
        if A.shape[1] == B.shape[0]:
            print("Result:\n", np.dot(A, B))
        else:
            print("Error: Invalid shapes for matrix multiplication.")
elif choice == 4:
    A = get_matrix("Matrix")
    print("Transpose:\n", np.transpose(A))
else:
    print("Invalid choice.")